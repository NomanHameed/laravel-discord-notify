{
    "name": "nomanhameed/laravel-discord-notify",
    "description": "A Laravel package for sending notifications to Discord channels via webhooks with rich embed support.",
    "type": "library",
    "keywords": ["laravel", "discord", "notifications", "webhook"],
    "license": "MIT",
    "authors": [
        {
            "name": "noman hameed",
            "email": "nomanbutt8322@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0",
        "guzzlehttp/guzzle": "^7.0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^8.0|^9.0"
    },
    "autoload": {
        "psr-4": {
            "NomanHameed\\DiscordNotify\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NomanHameed\\DiscordNotify\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NomanHameed\\DiscordNotify\\DiscordNotificationsServiceProvider"
            ],
            "aliases": {
                "Discord": "NomanHameed\\DiscordNotify\\Facades\\Discord"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
